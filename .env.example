# Web3 Configuration
# Get your WalletConnect Project ID from: https://cloud.walletconnect.com/
REACT_APP_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Get your Alchemy API Key from: https://www.alchemy.com/
REACT_APP_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Get your Infura API Key from: https://infura.io/
REACT_APP_INFURA_API_KEY=your_infura_api_key_here

# Blockchain Network Configuration
REACT_APP_CHAIN_ID=11155111
REACT_APP_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key_here

# App Configuration
REACT_APP_APP_NAME=PickMe ChooseMe LoveMe
REACT_APP_APP_DESCRIPTION=Where Dating Meets Design, AI, and Just the Right Amount of Drama

# Smart Contract Addresses (Update after deployment)
REACT_APP_ENTROPY_CONSUMER_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_BOOST_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REACT_APP_PYUSD_ADDRESS=0x6c3ea9036406852006290770BEdFcAbC0a3f8f6c

# Private Key for Deployment (Never commit to git!)
PRIVATE_KEY=your_private_key_here
